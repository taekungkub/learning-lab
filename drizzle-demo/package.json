{
  "name": "drizzle-demo",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:sync": "bun run db:generate && bun run db:migrate",
    "db:studio": "drizzle-kit studio",
    "seed": "bun run seed.ts",
    "db:setup": "bun run db:migrate && bun run seed",
    "reset": "rm -f drizzle-demo.sqlite && bun run db:setup"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "drizzle-kit": "^0.31.10"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "drizzle-orm": "^0.45.2"
  }
}
